{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "dockerfile": { "enabled": true },
  "customManagers": [
    {
      "customType": "regex",
      "description": "webtrees release pinned in the Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG WEBTREES_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "fisharebest/webtrees",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG PHP_EXTENSION_INSTALLER_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "mlocati/docker-php-extension-installer",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "PHP base image version (the FROM tag is composed from ARGs, which the dockerfile manager cannot rewrite)",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG PHP_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "php",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["fisharebest/webtrees"],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/",
      "labels": ["webtrees"]
    },
    {
      "description": "Stay on supported MariaDB LTS lines; no major jumps",
      "matchPackageNames": ["mariadb"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "One PR for all GitHub Actions updates; digest pins merge themselves once CI passes",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "matchUpdateTypes": ["pinDigest", "digest", "patch", "minor"],
      "automerge": true
    },
    {
      "description": "PHP is updated via the PHP_VERSION regex manager instead",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["php"],
      "enabled": false
    },
    {
      "description": "Alpine and PHP base images move together",
      "matchPackageNames": ["alpine", "php"],
      "groupName": "base images"
    }
  ]
}