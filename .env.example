# Copy to .env and adjust:  cp .env.example .env
# Any variable ending in a name below can instead be given as NAME_FILE=/path
# (e.g. DB_PASS_FILE=/run/secrets/db_pass) to read the value from a file.

# --- Compose -----------------------------------------------------------------
WEBTREES_PORT=8080
# WEBTREES_IMAGE=ghcr.io/vytux-com/webtrees:latest
# true = read-only root filesystem (incompatible with runtime WEBTREES_MODULES)
WEBTREES_READ_ONLY=false

# --- Runtime user ----------------------------------------------------------------
# uid/gid that runs nginx + php-fpm and owns the data volume (default 82 =
# www-data). Set to match existing host files, e.g. 1000 or 33. Must not be 0
# or 10001 (the owner of the webtrees code).
# PUID=82
# PGID=82

# --- Modules (composer packages) --------------------------------------------
# Baked into the image at build time (recommended; rebuild with --build):
WEBTREES_BUILD_MODULES=
# Installed when the container starts (needs network + root entrypoint):
WEBTREES_MODULES=
# Extra composer plugins to allow (magicsunday's installer is always allowed):
# WEBTREES_COMPOSER_ALLOW_PLUGINS=vendor/plugin
# Example:
# WEBTREES_BUILD_MODULES=magicsunday/webtrees-fan-chart magicsunday/webtrees-pedigree-chart

# --- Database ------------------------------------------------------------------
# Leave DB_TYPE and DB_HOST empty to use the interactive setup wizard instead.
DB_TYPE=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=webtrees
DB_USER=webtrees
DB_PASS=change-me-please
DB_PREFIX=wt_
# Seconds to wait for the database at startup.
DB_WAIT_TIMEOUT=60
# TLS to the database (paths inside the container):
# DB_KEY=
# DB_CERT=
# DB_CA=
# DB_VERIFY=false

# --- webtrees config.ini.php -----------------------------------------------------
# Public URL, no trailing slash. Required for pretty URLs.
BASE_URL=http://localhost:8080
PRETTY_URLS=true
# Behind a reverse proxy: comma separated proxy IPs/CIDRs, and headers to trust.
# TRUSTED_PROXIES=172.16.0.0/12
# TRUSTED_HEADERS=X-Forwarded-For
# Block bad bots by autonomous system number (comma separated):
# BLOCK_ASN=
# WT_DEBUG=false

# --- Initial administrator (created once, if it does not exist) -------------------
WT_USER=admin
WT_NAME=Administrator
WT_EMAIL=admin@example.com
WT_PASS=change-me-too

# --- Site settings (any webtrees site_setting, applied on every start) ------------
# WT_SITE_<SETTING>=value. Common ones:
# WT_SITE_LANGUAGE=en-GB
# WT_SITE_TIMEZONE=Europe/London
# WT_SITE_USE_REGISTRATION_MODULE=0
# WT_SITE_SMTP_ACTIVE=external
# WT_SITE_SMTP_HOST=smtp.example.com
# WT_SITE_SMTP_PORT=587
# WT_SITE_SMTP_SSL=tls
# WT_SITE_SMTP_AUTH=1
# WT_SITE_SMTP_AUTH_USER=webtrees@example.com
# WT_SITE_SMTP_AUTH_PASS=secret
# WT_SITE_SMTP_FROM_NAME=webtrees@example.com
# WT_SITE_SMTP_HELO=example.com

# --- PHP / web server tuning -------------------------------------------------------
# PHP_MEMORY_LIMIT=256M
# PHP_MAX_EXECUTION_TIME=60
# PHP_UPLOAD_MAX_FILESIZE=64M
# PHP_POST_MAX_SIZE=64M
# PHP_OPCACHE_VALIDATE_TIMESTAMPS=1
# FPM_PM=dynamic
# FPM_PM_MAX_CHILDREN=10
# NGINX_ACCESS_LOG=true
