#!/bin/sh
# Run php-fpm and nginx side by side; exit (so the container restarts) if
# either one dies. Runs as www-data.
set -eu

log() { printf '[webtrees] %s\n' "$*" >&2; }

php-fpm --nodaemonize &
fpm_pid=$!
nginx -e stderr -g 'daemon off;' &
nginx_pid=$!

stopping=0
shutdown() {
    stopping=1
    log "stopping"
    # QUIT = graceful shutdown for both nginx and php-fpm.
    kill -QUIT "$nginx_pid" "$fpm_pid" 2>/dev/null || true
}
trap shutdown TERM INT QUIT

log "listening on :8080"
while kill -0 "$fpm_pid" 2>/dev/null && kill -0 "$nginx_pid" 2>/dev/null; do
    sleep 2 &
    wait $! || true
done

if [ "$stopping" = 0 ]; then
    log "a service exited unexpectedly; shutting down"
    kill -TERM "$nginx_pid" "$fpm_pid" 2>/dev/null || true
    wait || true
    exit 1
fi

wait || true
